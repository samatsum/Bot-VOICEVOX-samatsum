# Discord
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_APPLICATION_ID=your_application_id_here
DISCORD_GUILD_ID=your_guild_id_here

# VOICEVOX
VOICEVOX_BASE_URL=http://127.0.0.1:50021

# Phase 10: shared database
# Cloud mode (recommended): libsql://... + token
# Local fallback: leave TURSO_DATABASE_URL empty and a local DB is created under data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Multi-PC lock. Normally leave these defaults.
INSTANCE_LOCK_TTL_MS=45000
INSTANCE_HEARTBEAT_MS=15000
