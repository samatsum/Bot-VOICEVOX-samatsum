{
  "name": "speakingbot",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Self-hosted Discord TTS bot using VOICEVOX, Discord.js, and Turso/libSQL",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start:prod": "node dist/index.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@libsql/client": "^0.18.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
