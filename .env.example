# Bot-VOICEVOX-samatsum 設定ファイルの見本
#
# このファイルを .env という名前でコピーし、実際の値は .env に入力します。
# .env.example はGitで公開されるため、実際のTokenを絶対に書かないでください。

# 必須: Discord Botの設定
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# VOICEVOX: 通常は変更不要
VOICEVOX_BASE_URL=http://127.0.0.1:50021

# 任意: 複数PCで設定を共有するためのTursoデータベース
# ローカルDBを使う場合は、両方とも空欄のままにします。
# 複数PCで共有する場合は、各PCの .env に同じURLとTokenを設定します。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
